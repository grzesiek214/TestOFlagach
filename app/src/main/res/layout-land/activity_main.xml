<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1F1F1F"
    android:gravity="center"
    android:orientation="horizontal"
    tools:context=".MainActivity">
    <!--
        Dla kazdego elementu musi byc wysokosc i szerokosc
        match_parent - rozmiar elementu taki jak u rodzica
        wrap_content - rozmiar dostosowany do zawartosci
    -->

    <TextView
        android:id="@+id/textViewPytanie"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:layout_weight="1"
        android:padding="8dp"
        android:text="@string/polecenie"
        android:textAlignment="center"
        android:textColor="#DCDCDC"
        android:textSize="@dimen/rozmiar_tekstu_pytanie" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/margin_button"
                android:layout_weight="1"
                android:backgroundTint="@color/green"
                android:onClick="sprawdzUkryj"
                android:text="" />

            <Button
                android:id="@+id/button2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/margin_button"
                android:layout_weight="1"
                android:backgroundTint="@color/white"
                android:onClick="sprawdzOk"
                android:text="" />

            <Button
                android:id="@+id/button3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/margin_button"
                android:layout_weight="1"
                android:backgroundTint="@color/yellow"
                android:onClick="sprawdzUkryj"
                android:text="" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/button4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/margin_button"
                android:layout_weight="1"
                android:backgroundTint="@color/black"
                android:onClick="sprawdzUkryj"
                android:text="" />

            <Button
                android:id="@+id/button5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/margin_button"
                android:layout_weight="1"
                android:backgroundTint="@color/blue"
                android:onClick="sprawdzUkryj"
                android:text="" />

            <Button
                android:id="@+id/button6"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/margin_button"
                android:layout_weight="1"
                android:backgroundTint="@color/red"
                android:onClick="sprawdzOk"
                android:text="" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>